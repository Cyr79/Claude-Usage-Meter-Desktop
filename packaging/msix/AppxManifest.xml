<?xml version="1.0" encoding="utf-8"?>
<!-- Replace the PLACEHOLDER_* values with the identity from Partner Center
     (Product management > Product identity) before uploading to the Store. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">

  <Identity
    Name="PLACEHOLDER_IDENTITY_NAME"
    Publisher="CN=PLACEHOLDER_PUBLISHER_ID"
    Version="2.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Claude Usage Meter</DisplayName>
    <PublisherDisplayName>PLACEHOLDER_PUBLISHER_DISPLAY_NAME</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="fr-fr" />
  </Resources>

  <Applications>
    <Application Id="ClaudeUsageMeter" Executable="claude-usage-meter.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Claude Usage Meter"
        Description="Claude.ai usage in the Windows tray"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Packaged apps can't use the HKCU Run key; this is the Store-approved autostart. -->
        <desktop:Extension Category="windows.startupTask" Executable="claude-usage-meter.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ClaudeUsageMeterStartup" Enabled="true" DisplayName="Claude Usage Meter" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
